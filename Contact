<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Contact Shashank Raj</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%93%A9%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#F7F8FA;--card:#fff;--tx:#0F172A;--mu:#526071;--bd:#E2E6EC;--ac:#0F766E;--acs:#E6F4F1;--f:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0B1116;--card:#111A21;--tx:#E8EEF2;--mu:#9AA8B4;--bd:#22303A;--ac:#2DD4BF;--acs:#10262A}}
:root[data-theme="dark"]{--bg:#0B1116;--card:#111A21;--tx:#E8EEF2;--mu:#9AA8B4;--bd:#22303A;--ac:#2DD4BF;--acs:#10262A}
*,*::before,*::after{box-sizing:inherit}
html{height:100%}
body{margin:0;min-height:100%;background:var(--bg);color:var(--tx);font:400 16px/1.6 var(--f)}
.wrap{max-width:640px;margin:0 auto;padding:clamp(28px,6vw,64px) 20px 60px}
.home-btn{display:inline-flex;align-items:center;gap:7px;color:var(--ac);text-decoration:none;font-size:.9rem;font-weight:600;margin-bottom:22px;border:1px solid var(--ac);border-radius:8px;padding:8px 14px}
.home-btn:hover{background:var(--acs)}
.home-btn svg{width:15px;height:15px}
h1{margin:0 0 6px;font-size:clamp(1.7rem,4vw,2.2rem);letter-spacing:-.015em}
.sub{color:var(--mu);margin:0 0 32px;max-width:52ch}
form{display:grid;gap:20px}
label{display:block;font-weight:600;font-size:.92rem;margin-bottom:8px}
input,textarea{width:100%;padding:13px 15px;border:1px solid var(--bd);border-radius:8px;background:var(--card);color:var(--tx);font:inherit;font-size:.95rem}
input::placeholder,textarea::placeholder{color:color-mix(in srgb,var(--mu) 80%,transparent)}
input:focus,textarea:focus{outline:2px solid var(--ac);outline-offset:1px;border-color:var(--ac)}
textarea{min-height:150px;resize:vertical}
button{margin-top:6px;width:100%;padding:15px;border:0;border-radius:8px;background:var(--ac);color:#fff;font:600 1rem var(--f);cursor:pointer;transition:transform .15s,opacity .15s}
button:hover{transform:translateY(-1px)}
button[disabled]{opacity:.7;cursor:default;transform:none}
.note{margin-top:14px;font-size:.85rem;color:var(--mu);text-align:center}
.note.ok{color:var(--ac);font-weight:600}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]) button{color:#04211d}}
:root[data-theme="dark"] button{color:#04211d}
</style>
</head>
<body>
<div class="wrap">
  <a class="home-btn" href="index.html">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>
    Home
  </a>
  <h1>Get in touch</h1>
  <p class="sub">Fill in the form below and it'll open a pre-filled email to rajshashank35@gmail.com — or reach out directly by email, phone or LinkedIn.</p>
  <form id="cform">
    <div>
      <label for="f-name">Name</label>
      <input id="f-name" name="name" type="text" placeholder="Enter Name" required autocomplete="name">
    </div>
    <div>
      <label for="f-email">Email</label>
      <input id="f-email" name="email" type="email" placeholder="Enter Email" required autocomplete="email">
    </div>
    <div>
      <label for="f-phone">Phone</label>
      <input id="f-phone" name="phone" type="tel" placeholder="Enter Phone" autocomplete="tel">
    </div>
    <div>
      <label for="f-message">Message</label>
      <textarea id="f-message" name="message" placeholder="Enter Message" required></textarea>
    </div>
    <button type="submit" id="sendBtn">Send</button>
    <div class="note" id="note"></div>
  </form>
</div>
<script>
document.getElementById('cform').addEventListener('submit', function(ev){
  ev.preventDefault();
  var name=document.getElementById('f-name').value.trim();
  var email=document.getElementById('f-email').value.trim();
  var phone=document.getElementById('f-phone').value.trim();
  var message=document.getElementById('f-message').value.trim();
  var subject='Portfolio contact form — ' + name;
  var body='Name: ' + name + '\nEmail: ' + email + (phone ? ('\nPhone: ' + phone) : '') + '\n\nMessage:\n' + message;
  var mailto='mailto:rajshashank35@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
  window.location.href = mailto;
  var note=document.getElementById('note');
  note.textContent='Opening your email app with this message pre-filled…';
  note.className='note ok';
});
</script>
</body>
</html>
